# Hostinger Unlimited / Apache-compatible LiteSpeed configuration.
# Public assets only; private files live outside public_html.
Options -Indexes
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    <FilesMatch "\.(html|php|js|css|json)$">
        Header always set Cache-Control "no-store"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>
<FilesMatch "(^\.|\.(sql|env|log|bak|zip|ini)$)">
    Require all denied
</FilesMatch>
